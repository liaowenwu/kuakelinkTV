<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/musicContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:paddingTop="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginHorizontal="56dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/music_all_songs" android:textSize="28sp" android:textStyle="bold" android:textColor="#EEF3F1"/>
  <TextView android:id="@+id/musicSearch" style="@style/TopButton" android:text="@string/music_find" android:textSize="14sp"/>
  <TextView android:id="@+id/musicRefresh" style="@style/TopButton" android:text="@string/music_refresh" android:textSize="14sp"/>
 </LinearLayout>
 <TextView android:id="@+id/musicStatus" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginHorizontal="56dp" android:textSize="12sp" android:textColor="#ABC3CE" android:gravity="center_vertical"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/musicPlaylist" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginHorizontal="56dp" android:paddingVertical="6dp" android:clipToPadding="false"/>
 <TextView android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginHorizontal="56dp" android:text="@string/music_list_keys" android:textColor="#ABC3CE" android:textSize="11sp" android:gravity="center_vertical"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="68dp" android:background="#C8142938">
  <ImageView android:id="@+id/musicCover" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/music_record" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
   <TextView android:id="@+id/musicNowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/music_select_song" android:textSize="18sp" android:textColor="#EDF3F1" android:singleLine="true" android:ellipsize="end"/>
   <TextView android:id="@+id/musicNowArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/music_player_hint" android:textSize="12sp" android:textColor="#ABC3CE" android:layout_marginTop="4dp"/>
  </LinearLayout>
  <ImageButton android:id="@+id/musicMiniPlay" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/music_round_button" android:src="@drawable/ic_play" android:contentDescription="@string/music_play_pause"/>
  <TextView android:id="@+id/musicOpenDetail" style="@style/TopButton" android:text="@string/music_detail" android:textSize="14sp"/>
 </LinearLayout>
</LinearLayout>
