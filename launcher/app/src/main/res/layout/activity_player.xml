<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 4K Hardware Accelerated Video Surface (TextureView to eliminate emulator/low-end box OpenGL & SurfaceView deadlock) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- Top Info Bar (Fade in with HUD) -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:background="@drawable/player_scrim_top">

        <TextView
            android:id="@+id/tvPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="影视名称 · 第 01 集"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/tvQualityTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_player_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="4K 原画 · 杜比全景声"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSystemClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="12:00"
            android:textColor="#B3FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_medium" />
    </LinearLayout>

    <!-- Center Buffering / Loading Indicator -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="正在缓冲 4K 原画视频流..."
            android:textColor="#E6FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom Seek / Control HUD -->
    <LinearLayout
        android:id="@+id/bottomControlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp"
        android:paddingTop="36dp"
        android:background="@drawable/card_scrim_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCurrentPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <!-- Custom Clean Progress Bar -->
            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:focusable="false"
                android:progressTint="#FFFFFFFF"
                android:secondaryProgressTint="#4DFFFFFF" />

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Bottom Remote Hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="按【下键】或【菜单键】快速选集换集 · 【左/右键】快退快进"
            android:textColor="#66FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Auto-Next Countdown Card -->
    <LinearLayout
        android:id="@+id/countdownNextLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_frosted_dialog"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCountdownTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="即将播放下一集：第 02 集"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCountdownSeconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="5 秒后自动播放"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_player_pill_active"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="【按 OK 键立即播放】"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Frosted Glass Episode Selection Drawer -->
    <LinearLayout
        android:id="@+id/inPlayerEpisodeDrawer"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_frosted_drawer"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:elevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDrawerSeriesTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选集 · 庆余年 第二季"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按【上键】或【返回键】关闭选集"
                android:textColor="#66FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrawerEpisodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingStart="34dp"
            android:paddingEnd="34dp" />
    </LinearLayout>

</FrameLayout>
