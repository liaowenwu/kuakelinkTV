<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_frosted_drawer"
    android:orientation="vertical"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="24dp">

    <!-- Header: Series Title and Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCollectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系列名称"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/tvCollectionMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="系列合集 · 共 3 部大片全收录 · 4K 杜比视界"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按【返回键】退出展架"
            android:textColor="#66FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Hairline divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#1AFFFFFF" />

    <!-- Horizontal Movies Shelf Carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCollectionMovies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="32dp"
        android:paddingEnd="32dp" />

</LinearLayout>
