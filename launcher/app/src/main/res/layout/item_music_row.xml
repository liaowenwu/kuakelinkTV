<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/music_row_bg"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <TextView
        android:id="@+id/musicRowIndex"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textColor="#8EABC0"
        android:textSize="13sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/musicRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F1F6FC"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/musicRowArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8EABC0"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/musicRowBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8CD9F6"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
