<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><solid android:color="#243EBAE8" /><corners android:radius="8dp" /></shape></item>
            <item android:gravity="bottom" android:height="3dp" android:left="16dp" android:right="16dp">
                <shape><solid android:color="#A5E9FF" /><corners android:radius="2dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom" android:height="2dp" android:left="16dp" android:right="16dp">
                <shape><solid android:color="#71C4E7" /><corners android:radius="2dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
